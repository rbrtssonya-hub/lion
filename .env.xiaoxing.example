# Copy to .env.xiaoxing.local for Node dev/preview/server only. Never commit the local copy.
# DeepSeek integration is prepared; API activation is intentionally deferred.
XIAOXING_AI_BASE_URL=https://api.deepseek.com
# Verify the available model in your DeepSeek account when activating.
XIAOXING_AI_MODEL=deepseek-flash
XIAOXING_AI_API_KEY=
XIAOXING_AI_TIMEOUT_MS=15000

# Official GPT-SoVITS api_v2 inference service, started separately on this computer.
# HTTPS or loopback HTTP only; the browser sends text and cannot override these values.
XIAOXING_TTS_URL=http://127.0.0.1:9880/tts
XIAOXING_TTS_TIMEOUT_MS=120000
# Blank uses source/characters/xiaoxing/voice/reference.wav relative to the installed runtime.
XIAOXING_TTS_REFERENCE_AUDIO=
# Optional reference transcript; v2ProPlus supports an empty transcript.
XIAOXING_TTS_REFERENCE_TEXT=
# Local launcher only; install the official project and its pretrained models first.
XIAOXING_GPT_SOVITS_ROOT=
XIAOXING_TTS_PYTHON=python
XIAOXING_TTS_PORT=9880
# Optional: scripts/xiaoxing/gpt-sovits-v2proplus-cpu.yaml for a CPU-only environment.
XIAOXING_TTS_CONFIG=

# Public EXE: use your HTTPS gateway instead of distributing a provider key.
# Set this in the launching computer's environment; it is not embedded by the builder.
XIAOXING_GATEWAY_URL=
XIAOXING_GATEWAY_TOKEN=

# Standalone deployment settings (use HTTPS reverse proxy for public access).
XIAOXING_HOST=127.0.0.1
XIAOXING_PORT=8787
XIAOXING_ALLOWED_ORIGINS=
# Optional server-to-server authorization; never expose this token in browser JS.
XIAOXING_ACCESS_TOKEN=
# Forces local answers and local-only TTS; zero remote model/gateway/TTS requests.
XIAOXING_OFFLINE=0
